---
services:
  adguardhome:
    image: adguard/adguardhome:latest
    container_name: adguardhome
    restart: unless-stopped
    ports:
      - "53:53/tcp"
      - "53:53/udp"
      - "3001:3000/tcp"  # Port 3000 is already used by Homepage
      - "80:80/tcp"
    volumes:
      - "{{ adguardhome_parent_dir }}/work:/opt/adguardhome/work"
      - "{{ adguardhome_parent_dir }}/conf:/opt/adguardhome/conf"